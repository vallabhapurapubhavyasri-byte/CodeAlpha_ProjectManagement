# TaskFlow Environment Configuration Example
# Copy this file to .env for production or custom local configurations

# Django Secret Key (Generate a secure unique string in production)
DJANGO_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production

# Debug Mode (Set to False in production)
DJANGO_DEBUG=True

# Allowed Hosts (Comma-separated list of hostnames or domains)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
